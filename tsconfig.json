{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "baseUrl": "src",
    "target": "esnext",
    "module": "esnext",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@screens/*": ["screens/*"],
      "@services/*": ["services/*"],
      "@navigation/*": ["navigation/*"],
      "@utils/*": ["utils/*"],
      "@config/*": ["config/*"],
      "@components/*": ["components/*"],
      "@store/*": ["store/*"],
      "@assets/*": ["../assets/*"]
    }
    // "noEmit": true,
    // "allowImportingTsExtensions": true
  },
  "include": ["src/**/*", "tamagui.config.ts"],
  "exclude": ["node_modules", "dist"]
}
